# /etc/pdf2zh-worker/worker.env 的样板
# install.sh 会自动生成一份；手工部署（容器/自定义路径）时照这个抄。
# 权限务必 0640 root:pdf2zh —— 这里面是明文 token。

# 必填：≥32 字符，太短 worker 直接拒绝启动
# 生成：openssl rand -hex 32
TRANSLATE_WORKER_TOKEN=请换成你自己的随机串不要照抄

# 只监听回环，公网走 nginx 443 反代（容器里改成 0.0.0.0，再用端口映射绑回 127.0.0.1）
TRANSLATE_WORKER_HOST=127.0.0.1
TRANSLATE_WORKER_PORT=8791

TRANSLATE_WORKER_DATA=/var/lib/pdf2zh-worker

# 要和主应用 admin 里这台 worker 行的并发填一致
TRANSLATE_WORKER_CONCURRENCY=1
TRANSLATE_WORKER_QUEUE_LIMIT=8
TRANSLATE_WORKER_MAX_MB=50
TRANSLATE_WORKER_RETENTION_HOURS=24
TRANSLATE_WORKER_SWEEP_MINUTES=30
TRANSLATE_WORKER_LOG_LEVEL=INFO

# 调优旋钮，一般不用动（说明见 README）
# TRANSLATE_WORKER_LLM_TIMEOUT=300
# TRANSLATE_WORKER_AUTO_GLOSSARY=false
# TRANSLATE_WORKER_REPORT_INTERVAL=0.5
# TRANSLATE_WORKER_POOL_MAX_WORKERS=
# 跳过本地翻译缓存。缓存键里的模型名对我们永远是占位符，主应用换了底层模型后
# 旧译文会继续被复用——换模型时要么开这个，要么跑一次 pdf2zh-worker clear-cache
# TRANSLATE_WORKER_IGNORE_CACHE=false

# pdf2zh / babeldoc 在 import 期就会往 HOME 写配置，必须指到可写目录
HOME=/var/lib/pdf2zh-worker
XDG_CACHE_HOME=/var/lib/pdf2zh-worker/cache
XDG_CONFIG_HOME=/var/lib/pdf2zh-worker/config
